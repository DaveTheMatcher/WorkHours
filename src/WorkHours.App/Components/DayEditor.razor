@inject WorkHoursRepository Repo

@if (_holidayName is not null)
{
    <div class="hint">
        🎉 Festivo: <strong>@_holidayName</strong>.
        Se per te non è festivo, scegli <em>Normale</em>.
    </div>
}

<div class="mb-3">
    <label class="form-label small text-muted mb-1">Tipo di giornata</label>
    <select class="form-select" @bind="_type" @bind:after="Edited">
        @foreach (var t in Enum.GetValues<DayType>())
        {
            <option value="@t">@Label(t)</option>
        }
    </select>
</div>

<label class="form-label d-block small text-muted mb-1">Fasce orarie</label>
@for (var i = 0; i < _slots.Count; i++)
{
    var slot = _slots[i];
    <div class="slot-row">
        <input type="time" class="form-control" aria-label="Inizio" @bind="slot.Start" @bind:after="Edited" />
        <span class="text-muted">–</span>
        <input type="time" class="form-control" aria-label="Fine" @bind="slot.End" @bind:after="Edited" />
        <button type="button" class="btn btn-link text-muted px-2" aria-label="Rimuovi fascia" @onclick="() => Remove(slot)">✕</button>
    </div>
}
<button type="button" class="btn btn-outline-secondary btn-sm mb-3" @onclick="AddSlot">+ Aggiungi fascia</button>

<div class="mb-3">
    <input class="form-control" placeholder="Note (facoltative)" @bind="_note" @bind:after="Edited" />
</div>

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <div class="fw-semibold">Totale @Format.Hours(Total)</div>
        <div class="small text-muted">@ExpectedText</div>
    </div>
    <button type="button" class="btn btn-primary px-4" @onclick="SaveAsync">Salva</button>
</div>

@foreach (var error in _errors)
{
    <div class="text-bad small">@error</div>
}
@if (_saved)
{
    <div class="text-ok small">Salvato ✓</div>
}

@code {
    [Parameter, EditorRequired] public DateOnly Date { get; set; }

    [Parameter] public EventCallback OnSaved { get; set; }

    private sealed class SlotRow
    {
        public TimeOnly Start { get; set; }
        public TimeOnly End { get; set; }
    }

    private DateOnly _loadedDate;
    private List<SlotRow> _slots = [];
    private DayType _type;
    private DayType _autoType;
    private string? _note;
    private string? _holidayName;
    private IReadOnlyList<string> _errors = [];
    private bool _saved;

    protected override void OnParametersSet()
    {
        if (Date == _loadedDate)
            return;
        _loadedDate = Date;

        var calc = Repo.CreateCalculator();
        var day = Repo.GetDay(Date);
        _holidayName = calc.HolidayName(Date);
        _autoType = _holidayName is not null ? DayType.Festivo : DayType.Lavoro;
        _type = calc.EffectiveType(Date);
        _note = day?.Note;
        _slots = day?.Slots.Select(s => new SlotRow { Start = s.Start, End = s.End }).ToList() ?? [];
        _errors = [];
        _saved = false;

        // Giorno lavorativo vuoto: propone già una prima fascia da compilare.
        if (_slots.Count == 0 && _type == DayType.Lavoro && Repo.Settings.ScheduleFor(Date).IsWorkingDay(Date))
            AddSlot();
    }

    private TimeSpan Total => _slots
        .Where(s => s.End > s.Start)
        .Aggregate(TimeSpan.Zero, (sum, s) => sum + (s.End - s.Start));

    private string ExpectedText
    {
        get
        {
            var schedule = Repo.Settings.ScheduleFor(Date);
            if (_type.CoversTarget())
                return "Giornata coperta: non conta nel monte ore";
            if (!schedule.IsWorkingDay(Date))
                return "Giorno libero: le ore contano come extra";
            return $"Previste {Format.Hours(schedule.DailyHours)}";
        }
    }

    private static string Label(DayType t) => t switch
    {
        DayType.Lavoro => "Normale",
        _ => t.ToString(),
    };

    private void AddSlot()
    {
        var start = _slots.Count > 0 ? _slots[^1].End : new TimeOnly(9, 0);
        var end = start < new TimeOnly(23, 0) ? start.AddHours(1) : new TimeOnly(23, 59);
        _slots.Add(new SlotRow { Start = start, End = end });
        Edited();
    }

    private void Remove(SlotRow slot)
    {
        _slots.Remove(slot);
        Edited();
    }

    private void Edited()
    {
        _saved = false;
        _errors = [];
    }

    private async Task SaveAsync()
    {
        var day = new WorkDay
        {
            Date = Date,
            Slots = _slots.Select(s => new TimeSlot(s.Start, s.End)).ToList(),
            // Se coincide con quello automatico non lo forziamo: così, se cambiano i festivi, resta coerente.
            Type = _type == _autoType ? null : _type,
            Note = _note,
        };

        _errors = await Repo.SaveDayAsync(day);
        _saved = _errors.Count == 0;
        if (_saved)
            await OnSaved.InvokeAsync();
    }
}
