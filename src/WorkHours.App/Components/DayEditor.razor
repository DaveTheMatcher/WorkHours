@inject WorkHoursRepository Repo

@if (_holidayName is not null)
{
    <div class="hint">
        🎉 Festivo: <strong>@_holidayName</strong>.
        Se per te non è festivo, scegli <em>Normale</em>.
    </div>
}

<div class="mb-3">
    <label class="form-label small text-muted mb-1">Tipo di giornata</label>
    <select class="form-select" @bind="_type" @bind:after="Edited">
        @foreach (var t in Enum.GetValues<DayType>())
        {
            <option value="@t">@Label(t)</option>
        }
    </select>
</div>

@if (_oldSlotsText is not null)
{
    <div class="hint">
        Questo giorno era stato inserito a fasce (@_oldSlotsText).
        Qui sotto trovi presenza e pausa equivalenti: se salvi, passa al nuovo formato con le stesse ore.
    </div>
}

<label class="form-label d-block small text-muted mb-1">Presenza (pausa compresa)</label>
<div class="duration-row mb-2">
    <input type="number" class="form-control" inputmode="numeric" min="0" max="24" placeholder="0" aria-label="Ore di presenza"
           @bind="_presenceHours" @bind:event="oninput" @bind:after="Edited" />
    <span class="text-muted">ore</span>
    <input type="number" class="form-control" inputmode="numeric" min="0" max="59" placeholder="0" aria-label="Minuti di presenza"
           @bind="_presenceMinutes" @bind:event="oninput" @bind:after="Edited" />
    <span class="text-muted">min</span>
</div>

<label class="form-label d-block small text-muted mb-1">Pausa</label>
<div class="duration-row mb-3">
    <input type="number" class="form-control" inputmode="numeric" min="0" max="24" placeholder="0" aria-label="Ore di pausa"
           @bind="_pauseHours" @bind:event="oninput" @bind:after="Edited" />
    <span class="text-muted">ore</span>
    <input type="number" class="form-control" inputmode="numeric" min="0" max="59" placeholder="0" aria-label="Minuti di pausa"
           @bind="_pauseMinutes" @bind:event="oninput" @bind:after="Edited" />
    <span class="text-muted">min</span>
</div>

<div class="mb-3">
    <input class="form-control" placeholder="Note (facoltative)" @bind="_note" @bind:after="Edited" />
</div>

<div class="d-flex align-items-center justify-content-between mb-2">
    <div>
        <div class="fw-semibold">Lavorate @Format.Hours(Total)</div>
        <div class="small text-muted">@ExpectedText</div>
    </div>
    <button type="button" class="btn btn-primary px-4" @onclick="SaveAsync">Salva</button>
</div>

@foreach (var error in _errors)
{
    <div class="text-bad small">@error</div>
}
@if (_saved)
{
    <div class="text-ok small">Salvato ✓</div>
}

@code {
    [Parameter, EditorRequired] public DateOnly Date { get; set; }

    [Parameter] public EventCallback OnSaved { get; set; }

    private DateOnly _loadedDate;
    private int? _presenceHours;
    private int? _presenceMinutes;
    private int? _pauseHours;
    private int? _pauseMinutes;
    private string? _oldSlotsText;
    private DayType _type;
    private DayType _autoType;
    private string? _note;
    private string? _holidayName;
    private IReadOnlyList<string> _errors = [];
    private bool _saved;

    protected override void OnParametersSet()
    {
        if (Date == _loadedDate)
            return;
        _loadedDate = Date;

        var calc = Repo.CreateCalculator();
        var day = Repo.GetDay(Date);
        _holidayName = calc.HolidayName(Date);
        _autoType = _holidayName is not null ? DayType.Festivo : DayType.Lavoro;
        _type = calc.EffectiveType(Date);
        _note = day?.Note;
        _errors = [];
        _saved = false;

        // Giorni inseriti a fasce: si mostrano già convertiti in presenza e pausa (stesse ore lavorate).
        _oldSlotsText = day is { UsesSlots: true }
            ? string.Join(", ", day.Slots.OrderBy(s => s.Start).Select(s => $"{s.Start:HH\\:mm}–{s.End:HH\\:mm}"))
            : null;
        var (presence, pause) = day?.ToPresenceAndPause() ?? (TimeSpan.Zero, TimeSpan.Zero);
        (_presenceHours, _presenceMinutes) = Split(presence);
        (_pauseHours, _pauseMinutes) = Split(pause);
    }

    /// <summary>Zero diventa campo vuoto, così si vede il segnaposto e si scrive subito.</summary>
    private static (int?, int?) Split(TimeSpan value)
    {
        if (value <= TimeSpan.Zero)
            return (null, null);
        var minutes = (int)Math.Round(value.TotalMinutes);
        return (minutes / 60, minutes % 60 == 0 ? null : minutes % 60);
    }

    /// <summary>Null se entrambi i campi sono vuoti. I minuti oltre 59 si sommano (90 min = 1h 30min).</summary>
    private static TimeSpan? Join(int? hours, int? minutes) =>
        hours is null && minutes is null ? null : TimeSpan.FromMinutes((hours ?? 0) * 60 + (minutes ?? 0));

    private TimeSpan? Presence => Join(_presenceHours, _presenceMinutes);

    /// <summary>Una pausa a zero equivale a nessuna pausa.</summary>
    private TimeSpan? Pause => Join(_pauseHours, _pauseMinutes) is { } p && p != TimeSpan.Zero ? p : null;

    private TimeSpan Total => new WorkDay { Presence = Presence, Pause = Pause }.Worked;

    private string ExpectedText
    {
        get
        {
            var schedule = Repo.Settings.ScheduleFor(Date);
            if (_type.CoversTarget())
                return "Giornata coperta: non conta nel monte ore";
            if (!schedule.IsWorkingDay(Date))
                return "Giorno libero: le ore contano come extra";
            return $"Previste {Format.Hours(schedule.DailyHours)}";
        }
    }

    private static string Label(DayType t) => t switch
    {
        DayType.Lavoro => "Normale",
        _ => t.ToString(),
    };

    private void Edited()
    {
        _saved = false;
        _errors = [];
    }

    private async Task SaveAsync()
    {
        var day = new WorkDay
        {
            Date = Date,
            Presence = Presence,
            Pause = Pause,
            // Se coincide con quello automatico non lo forziamo: così, se cambiano i festivi, resta coerente.
            Type = _type == _autoType ? null : _type,
            Note = _note,
        };

        _errors = await Repo.SaveDayAsync(day);
        _saved = _errors.Count == 0;
        if (_saved)
        {
            _oldSlotsText = null;
            await OnSaved.InvokeAsync();
        }
    }
}
